# Kea Parrot — .env.example (Product P0)
# ---------------------------------------------------------------------------
# PLACEHOLDER VALUES ONLY. No real secret appears in this file, and this file
# is the ONLY env file committed to the repo (.gitignore ignores every real
# env file). Copy to .env.local for local dev and fill in values from the
# Supabase / Vercel / Sentry dashboards — never paste a real value here,
# never paste a real value into chat, docs, or a commit message.
#
# One set of values per environment (D-08): local, automated testing
# (ephemeral, CI-run), staging, production. Each environment has its own
# Supabase project (except local, which uses the Supabase CLI) and its own
# credentials. Never point local/staging at production resources.
# ---------------------------------------------------------------------------

# --- App ---
# Public URL of this deployment (used for auth redirects, links, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (public — safe to expose in the browser) ---
# Find these in the Supabase dashboard for the environment's project:
# Project Settings → API. NOTE (W6): use the new publishable/secret API keys,
# not the legacy anon / service_role JWT keys (deprecated end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# --- Supabase (SERVER-ONLY — never NEXT_PUBLIC_, never in browser code) ---
# The service-role key bypasses Row Level Security. It must only ever be
# used in trusted server contexts (KEA-SAD-001 §9.3, KEA-DBS-002 §8).
# Never put it in a NEXT_PUBLIC_ variable, a browser bundle, an API
# response, a log, or the repo. If it is ever exposed, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# --- Sentry (error monitoring, KEA-SAD-001 §15.1) ---
# DSN from the Sentry dashboard for the environment's project.
# No secret values, tokens, or PII may be sent in Sentry events (see
# infrastructure/monitoring/sentry.*.config.ts).
SENTRY_DSN=https://YOUR_SENTRY_DSN_HERE
# Optional: release / environment tags (set in deployment, not here).
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=

# --- Notes for later phases (do NOT fill in during P0) ---
# Analytics provider, email provider, push provider and moderation service
# are all TBD (OD-19) — no variables for them exist yet. Payment variables
# must never exist before Product P4 (OD-20).
