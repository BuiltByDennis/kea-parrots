{
  "name": "kea-parrot-web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --root ../.. tests",
    "test:watch": "vitest",
    "test:unit": "vitest run --root ../.. tests/unit",
    "test:component": "vitest run --root ../.. tests/component",
    "test:integration": "vitest run --root ../.. tests/integration",
    "test:api": "vitest run --root ../.. tests/api",
    "test:db": "vitest run --root ../.. tests/db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "11.16.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "type": "module"
}
